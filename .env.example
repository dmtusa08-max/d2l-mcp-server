# D2L Brightspace configuration

# Your institution's Brightspace hostname.
#   University of Limerick : learn.ul.ie
#   Broward College        : bconline.broward.edu
D2L_HOST=bconline.broward.edu

# Default course ID (optional) - if set, you don't need to specify orgUnitId in every request.
# Find yours by calling the get_my_courses tool.
D2L_COURSE_ID=

# Identity provider (only needed on instances that show an IdP picker, like Broward).
# Leave blank to accept the page default. Broward's options are:
#   https://app.onelogin.com/saml/metadata/767507                                (default)
#   https://app.onelogin.com/saml/metadata/df3f5090-84af-438a-bf14-eee116353e7d
#   https://sts.windows.net/7bd8e629-33bc-43c4-870c-cd3841be1658/                (Microsoft)
D2L_SSO_IDP=

# Which browser to drive for login. Playwright's bundled Chromium is pinned and
# goes stale, and D2L rejects it as unsupported once it falls far enough behind.
# "chrome" (the default) uses the Google Chrome installed on this machine, which
# keeps itself updated. Set to "bundled" to force Playwright's own Chromium.
D2L_BROWSER_CHANNEL=chrome
